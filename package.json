{
  "name": "dotfiles-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for managing dotfiles - syncing, checking differences, and initializing on new devices",
  "bin": {
    "dot": "./dist/main.js"
  },
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --compile --outfile dot",
    "build:dev": "tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e:ai": "bun run build && bash scripts/test-ai-e2e.sh",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "effect-language-service patch",
    "dev": "bun run src/main.ts",
    "sync": "git pull && bun run build && ./dot sync"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.35",
    "effect": "4.0.0-beta.35",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.80.0",
    "@effect/vitest": "4.0.0-beta.35",
    "@types/bun": "latest",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
